{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "types": ["node"],
    "noEmit": false,
    "outDir": ".test-build",
    "incremental": false
  },
  "include": ["lib/server/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
